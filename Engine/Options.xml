    <Parameter>
        <RequestType>FreeText</RequestType>
        <Description>LOD_shadowWeldedLevels</Description>
        <!--Build a second, position welded copy of the coarse levels for shadow cameras. Welding drops normals and UVs, which a depth only pass never samples, and buys about 3x at the coarse end. Nothing that samples a texture can ever pick one. Changing this invalidates every cached calibration, so the next load recalibrates and regenerates every source model. A limonmodel keeps the levels it was exported with until it is re-exported-->
        <Value>True</Value>
        <valueType>Boolean</valueType>
        <IsSet>True</IsSet>
        <Index>64</Index>
    </Parameter>
    <Parameter>
        <RequestType>FreeText</RequestType>
        <Description>LOD_calibrate</Description>
        <!--Generate and check each model's levels at load. Off makes nothing new: a model uses the levels its sidecar or limonmodel already holds, otherwise the original. That is what a Raspberry Pi build wants-->
        <Value>True</Value>
        <valueType>Boolean</valueType>
        <IsSet>True</IsSet>
        <Index>65</Index>
    </Parameter>
    <Parameter>
        <RequestType>FreeNumber</RequestType>
        <Description>LOD_calibrateSearchSteps</Description>
        <!--Bisection steps per level. Each step renders the model from 14 directions to measure it, so more steps cost load time and land on a slightly larger error-->
        <Value>7</Value>
        <valueType>Long</valueType>
        <IsSet>True</IsSet>
        <Index>66</Index>
    </Parameter>
    <Parameter>
        <RequestType>FreeNumber</RequestType>
        <Description>LOD_switchHysteresis</Description>
        <!--How far past a switch point an object has to move before switching back, as a fraction. Stops an object sitting on a threshold from flipping every frame-->
        <Value>0.15</Value>
        <valueType>Double</valueType>
        <IsSet>True</IsSet>
        <Index>67</Index>
    </Parameter>
    <Parameter>
        <RequestType>FreeNumber</RequestType>
        <Description>LOD_forceLevel</Description>
        <!--Forces every model to this LOD level so one level can be inspected everywhere it would appear. -1 picks levels normally-->
        <Value>-1</Value>
        <valueType>Long</valueType>
        <IsSet>True</IsSet>
        <Index>69</Index>
    </Parameter>
    <Parameter>
        <RequestType>FreeNumber</RequestType>
        <Description>LOD_shadowWeldedFromLevel</Description>
        <!--First level to get a welded twin for depth only cameras, which drop uvs and normals. Shadows use the original and the levels before it as they are. Changing this invalidates every cached calibration, so the next load recalibrates and regenerates every source model. A limonmodel keeps the levels it was exported with until it is re-exported-->
        <Value>2</Value>
        <valueType>Long</valueType>
        <IsSet>True</IsSet>
        <Index>70</Index>
    </Parameter>
    <Parameter>
        <RequestType>FreeNumber</RequestType>
        <Description>LOD_normalDeviation</Description>
        <!--How far a normal may move before a pixel counts as damaged, as the length of the difference. That length is the most diffuse brightness can change under any light, so 0.05 is 5%. Changing this invalidates every cached calibration, so the next load recalibrates and regenerates every source model. A limonmodel keeps the levels it was exported with until it is re-exported-->
        <Value>0.2</Value>
        <valueType>Double</valueType>
        <IsSet>True</IsSet>
        <Index>73</Index>
    </Parameter>
    <Parameter>
        <RequestType>FreeNumber</RequestType>
        <Description>LOD_levelDistances</Description>
        <!--Where each level is used, in meters, times the instance scale. Each level is generated as the coarsest simplification that stays inside its pixel limits when seen from exactly this distance, so the triangle count is a result, not a setting. The first number is the element count plus one, not a value. Every LOD_level list must have the same length; an empty list means no levels at all. Changing a distance regenerates that level only-->
        <Value>4, 50, 100, 200</Value>
        <valueType>FloatArray</valueType>
        <IsSet>True</IsSet>
        <Index>74</Index>
    </Parameter>
    <Parameter>
        <RequestType>FreeNumber</RequestType>
        <Description>LOD_levelTriangleTargets</Description>
        <!--Percent of the original each level is hoped to keep. Only reported in the editor next to what was reached, it decides nothing, except for animated models, which can not be rendered for a check and are built straight to these-->
        <Value>4, 80, 60, 40</Value>
        <valueType>FloatArray</valueType>
        <IsSet>True</IsSet>
        <Index>75</Index>
    </Parameter>
    <Parameter>
        <RequestType>FreeNumber</RequestType>
        <Description>LOD_levelSurfacePixels</Description>
        <!--How far the visible surface may move at the level's distance, in pixels of the reference screen. A texture sliding a few texels counts here too. Negative switches the check off-->
        <Value>4, 4, 3, 4</Value>
        <valueType>FloatArray</valueType>
        <IsSet>True</IsSet>
        <Index>76</Index>
    </Parameter>
    <Parameter>
        <RequestType>FreeNumber</RequestType>
        <Description>LOD_levelOutlinePixels</Description>
        <!--How far the silhouette may move at the level's distance, in pixels of the reference screen. Negative switches the check off-->
        <Value>4, 4, 3, 4</Value>
        <valueType>FloatArray</valueType>
        <IsSet>True</IsSet>
        <Index>77</Index>
    </Parameter>
    <Parameter>
        <RequestType>FreeNumber</RequestType>
        <Description>LOD_levelHolePixels</Description>
        <!--How wide the widest hole may be at the level's distance, where something behind shows through, in pixels of the reference screen. Negative switches the check off-->
        <Value>4, 2, 6, 8</Value>
        <valueType>FloatArray</valueType>
        <IsSet>True</IsSet>
        <Index>78</Index>
    </Parameter>
    <Parameter>
        <RequestType>FreeNumber</RequestType>
        <Description>LOD_levelTexturePixels</Description>
        <!--How wide the widest patch may be where the uv jumped to another part of the texture, at the level's distance, in pixels of the reference screen. Negative switches the check off-->
        <Value>4, 8, 12, 16</Value>
        <valueType>FloatArray</valueType>
        <IsSet>True</IsSet>
        <Index>79</Index>
    </Parameter>
    <Parameter>
        <RequestType>FreeNumber</RequestType>
        <Description>LOD_levelNormalPixels</Description>
        <!--How wide the widest patch may be whose shading changed past LOD_normalDeviation, at the level's distance, in pixels of the reference screen. Negative switches the check off-->
        <Value>4, 8, 12, 16</Value>
        <valueType>FloatArray</valueType>
        <IsSet>True</IsSet>
        <Index>80</Index>
    </Parameter>
    <Parameter>
        <RequestType>FreeNumber</RequestType>
        <Description>LOD_referenceHeight</Description>
        <!--Height in pixels of the screen levels are judged for, with LOD_referenceFov. The default is a 1080p low end screen; this machine's own resolution doesn't matter. Changing it regenerates every level-->
        <Value>1080</Value>
        <valueType>Long</valueType>
        <IsSet>True</IsSet>
        <Index>81</Index>
    </Parameter>
    <Parameter>
        <RequestType>FreeNumber</RequestType>
        <Description>LOD_referenceFov</Description>
        <!--Vertical field of view in degrees of the screen levels are judged for, with LOD_referenceHeight. Changing it regenerates every level-->
        <Value>60.0</Value>
        <valueType>Double</valueType>
        <IsSet>True</IsSet>
        <Index>82</Index>
    </Parameter>
    <Parameter>
        <RequestType>FreeNumber</RequestType>
        <Description>LOD_calibrationMaxResolution</Description>
        <!--Largest image the check renders, twice the model's real size on screen at the level's distance. A big model close up needs more and is checked at reduced precision, the editor says so. Cost grows with the square of this. Changing it regenerates every level-->
        <Value>2048</Value>
        <valueType>Long</valueType>
        <IsSet>True</IsSet>
        <Index>83</Index>
    </Parameter>
    <Parameter>
        <RequestType>FreeNumber</RequestType>
        <Description>LOD_maxSkipRenderSize</Description>
        <!-- This variable sets what is the size of objects can't be skipped. This is required because objects like ground/wall skipping can be visually jarring-->
        <Value>3</Value>
        <valueType>Double</valueType>
        <IsSet>True</IsSet>
        <Index>13</Index>
    </Parameter>
    <Parameter>
        <RequestType>FreeNumber</RequestType>
        <Description>LOD_skipRenderDistance</Description>
